# --- Database ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=padel_booking
MYSQL_USER=padel_user
MYSQL_PASSWORD=change_me
MYSQL_PORT=3307
DB_CONNECTION_STRING="Server=localhost;Port=3307;Database=padel_booking;User=padel_user;Password=change_me;"

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_string
